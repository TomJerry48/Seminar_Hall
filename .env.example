# SSMIET HallSync AI — Environment Configuration

# Server Port (Default: 3000)
PORT=3000

# Frontend Base URL for API Requests (Optional, defaults to '/api')
VITE_API_BASE_URL="/api"
FRONTEND_URL="http://localhost:3000"

# JWT Secret for Token Signing & Verification
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# PostgreSQL Connection Variables (Object Method)
SQL_HOST="/cloudsql/YOUR_PROJECT:YOUR_REGION:YOUR_INSTANCE"
SQL_DB_NAME="postgres"
SQL_USER="YOUR_APP_DB_USER"
SQL_PASSWORD="YOUR_APP_DB_PASSWORD"

# PostgreSQL Admin Credentials for Drizzle Schema Migrations
SQL_ADMIN_USER="YOUR_ADMIN_DB_USER"
SQL_ADMIN_PASSWORD="YOUR_ADMIN_DB_PASSWORD"

# Optional Gemini API Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
